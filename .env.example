# Example Environment Configuration
# Copy this file to .env.local and fill in your actual values

# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@your-host.neon.tech/your-database?sslmode=require"

# Razorpay Configuration (Use test keys for development)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_WHATSAPP_NUMBER="+1234567890"

# WhatsApp Test Mode (true = console only, false = actually sends)
WHATSAPP_TEST_MODE="true"

# WhatsApp Content Template SIDs V2
# Get these from Twilio Console after creating templates
TWILIO_TEMPLATE_DONATION_RECEIPT_V2="HXxxxxxxxxxxxxx"
TWILIO_TEMPLATE_POOJA_BOOKING_V2="HXxxxxxxxxxxxxx"
TWILIO_TEMPLATE_PARIHARA_BOOKING_V2="HXxxxxxxxxxxxxx"
TWILIO_TEMPLATE_ASTROLOGY_BOOKING_V2="HXxxxxxxxxxxxxx"
TWILIO_TEMPLATE_ADMIN_DONATION_V2="HXxxxxxxxxxxxxx"
TWILIO_TEMPLATE_ADMIN_POOJA_V2="HXxxxxxxxxxxxxx"
TWILIO_TEMPLATE_ADMIN_PARIHARA_V2="HXxxxxxxxxxxxxx"
TWILIO_TEMPLATE_ADMIN_ASTROLOGY_V2="HXxxxxxxxxxxxxx"

# Temple Information
TEMPLE_NAME="Your Temple Name"
TEMPLE_PHONE_1="+1234567890"
TEMPLE_PHONE_2="+1234567890"
TEMPLE_EMAIL="info@temple.org"
TEMPLE_ADDRESS="Temple Address Here"

# Base URL for the application
NEXT_PUBLIC_BASE_URL="http://localhost:3001"

# Admin Authentication
NEXT_PUBLIC_ADMIN_PASSWORD="your_admin_password"

# Email Service (SendGrid) - Optional
SENDGRID_API_KEY="SG.your_sendgrid_api_key"
SENDGRID_FROM_EMAIL="noreply@temple.org"

# Certificate Generator Service - Optional (for local development)
CERTIFICATE_SERVICE_URL="http://localhost:5001"
CHROME_PATH="/path/to/chrome"
